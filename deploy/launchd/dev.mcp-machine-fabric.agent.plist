<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/install-agent.sh XML-escapes and fills all @...@ values. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.mcp-machine-fabric.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NODE@</string>
    <string>@HOME@/.local/opt/mcp-machine-fabric/current/dist/cli.js</string>
    <string>agent</string>
    <string>--token-file</string><string>@HOME@/.config/mmf/agent.token</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@HOME@</string>
    <key>PATH</key><string>@PATH@</string>
    <key>MMF_HUB_URL</key><string>@MMF_HUB_URL@</string>
    <key>MMF_ROOTS</key><string>@MMF_ROOTS@</string>
    <key>MMF_READ_ONLY</key><string>@MMF_READ_ONLY@</string>
    <key>MMF_NO_EXEC</key><string>@MMF_NO_EXEC@</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- Durable jobs run in their own process groups; never reap them when the agent exits. -->
  <key>AbandonProcessGroup</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/mmf-agent.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/mmf-agent.log</string>
</dict>
</plist>
